---
// An illustration of the drag, not the app: a small model of a Mac menu bar whose clock can be pulled. The cord's
// length steps through the same ladder as DurationLadder in Sources/DragTimer/Physics/DragPhysics.swift (every
// minute to 15 min, every 5 min to 1 h, every 15 min to 4 h, the default maximum) and catches at the SnapGrid
// points. The real ruler costs 20 points a step; here a step is shortened so 4 hours fits inside the picture.
import { icon } from '../lib/icons';
---
<div class="demo" data-drag-demo>
  <div class="desk" role="group" aria-label="Demo: a Mac menu bar with Drag Timer's clock in it">
    <div class="menubar">
      <span class="mb-apps" aria-hidden="true"><b>Finder</b><span>File</span><span>Edit</span><span>View</span></span>
      <span class="mb-status">
        <button class="clock" type="button" data-clock aria-label="Drag Timer clock. Drag away from it to set a timer." aria-describedby="drag-demo-keys">
          <svg class="clock-glyph" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
            <circle class="clock-ring" cx="9" cy="9" r="6.6" />
            <path class="clock-hands" d="M9 5.4V9l2.5 1.5" />
            <path class="clock-bang" d="M9 5.2v4.6M9 12.4v.3" />
          </svg>
          <span class="clock-text" data-count></span>
        </button>
        <span class="mb-extras" aria-hidden="true">
          <span set:html={icon('wifi', 15)} />
          <span set:html={icon('battery-medium', 17)} />
          <span class="mb-time" data-now>9:41 AM</span>
        </span>
      </span>
    </div>

    <svg class="cord" data-cord aria-hidden="true">
      <line data-line x1="0" y1="0" x2="0" y2="0" />
      <circle class="knob" data-knob r="9" />
      <circle class="knob-dot" data-knob-dot r="2.6" />
    </svg>
    <div class="tag" data-tag aria-hidden="true" hidden><strong data-tag-length></strong><span data-tag-time></span></div>

    <p class="desk-hint" data-hint>Press the clock and drag away from it</p>
    <div class="desk-status" data-status hidden>
      <span data-status-text></span>
      <button type="button" class="desk-btn" data-reset>Stop all</button>
    </div>
    <p class="visually-hidden" id="drag-demo-keys">In this demo the arrow keys also work: Down lengthens the timer, Up shortens it, Return starts it and Escape cancels.</p>
    <p class="visually-hidden" aria-live="polite" data-live></p>
  </div>
</div>

<style>
  .demo { position: relative; width: 100%; max-width: 560px; margin: 0 auto; }
  .desk {
    --cord: #f46f62;
    position: relative; height: 330px; border-radius: 16px; overflow: hidden;
    background: var(--stage); border: 1px solid var(--stage-edge); box-shadow: var(--shadow-lg);
    color: #f4f2ec; user-select: none; -webkit-user-select: none;
  }
  .desk.snapped { --cord: #63e6e2; }
  .menubar {
    position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    height: 32px; padding: 0 12px; background: rgb(4 8 20 / 0.55); border-bottom: 1px solid rgb(255 255 255 / 0.07);
    font: 500 13px/1 var(--font);
  }
  .mb-apps { display: flex; align-items: center; gap: 14px; min-width: 0; overflow: hidden; white-space: nowrap; color: rgb(244 242 236 / 0.78); }
  .mb-apps b { font-weight: 700; color: #f4f2ec; }
  .mb-status { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
  .mb-extras { display: flex; align-items: center; gap: 12px; color: rgb(244 242 236 / 0.86); margin-left: 6px; }
  .mb-extras :global(svg) { display: block; }
  .mb-time { font-variant-numeric: tabular-nums; white-space: nowrap; }

  .clock {
    position: relative; display: inline-flex; align-items: center; gap: 5px; height: 26px; min-width: 34px; padding: 0 8px;
    justify-content: center; border: 0; border-radius: 6px; background: transparent; color: #f4f2ec; cursor: grab;
    font: 600 13px/1 var(--font); font-variant-numeric: tabular-nums; touch-action: none; -webkit-tap-highlight-color: transparent;
  }
  .clock:hover, .desk.dragging .clock { background: rgb(255 255 255 / 0.16); }
  .desk.dragging .clock { cursor: grabbing; }
  .clock:focus-visible { outline: 2px solid #f4f2ec; outline-offset: 1px; }
  .clock.by-pointer:focus-visible { outline: none; }
  .clock-glyph { display: block; overflow: visible; }
  .clock-ring { fill: none; stroke: currentColor; stroke-width: 1.6; }
  .clock-hands, .clock-bang { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .clock-bang { display: none; }
  .clock-text:empty { display: none; }
  .desk.running .clock-ring { stroke: #f46f62; stroke-width: 2.2; }
  .desk.finished .clock-ring { fill: #ff453a; stroke: #ff453a; }
  .desk.finished .clock-hands { display: none; }
  .desk.finished .clock-bang { display: block; stroke: #fff; }
  @media (pointer: coarse) { .clock { min-width: 46px; height: 32px; } }
  /* a quiet ring that says the clock can be pulled */
  .clock::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 30px; height: 30px; margin: -15px 0 0 -15px;
    border-radius: 50%; border: 1.5px solid #f46f62; opacity: 0; pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .desk.idle .clock::after { animation: demo-pulse 2.4s ease-out infinite; }
    @keyframes demo-pulse { 0% { opacity: 0.9; transform: scale(0.7); } 70%, 100% { opacity: 0; transform: scale(1.9); } }
  }

  .cord { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; visibility: hidden; }
  .desk.dragging .cord { visibility: visible; }
  .cord line { stroke: var(--cord); stroke-width: 5; stroke-linecap: round; }
  .knob { fill: var(--cord); }
  .knob-dot { fill: #fff; }
  .desk.cancelling .cord line, .desk.cancelling .knob, .desk.cancelling .knob-dot { visibility: hidden; }

  .tag {
    position: absolute; z-index: 4; left: 0; top: 0; display: flex; flex-direction: column; align-items: center; gap: 3px;
    min-width: 84px; padding: 8px 16px 9px; border-radius: 999px; pointer-events: none; white-space: nowrap;
    background: #171a24; border: 1px solid rgb(255 255 255 / 0.2); box-shadow: 0 8px 22px -8px rgb(0 0 0 / 0.7);
    font-family: var(--font); line-height: 1; font-variant-numeric: tabular-nums;
  }
  .tag[hidden] { display: none; }
  .tag strong { font-size: 16px; font-weight: 600; color: #fff; }
  .tag span { font-size: 12px; color: rgb(244 242 236 / 0.72); }
  .tag span:empty { display: none; }

  .desk-hint, .desk-status {
    position: absolute; left: 16px; right: 16px; bottom: 18px; z-index: 1; margin: 0; text-align: center;
    font-size: 14px; line-height: 1.45; color: rgb(244 242 236 / 0.74);
  }
  .desk.dragging .desk-hint { opacity: 0.4; }
  .desk-status { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 12px; color: #f4f2ec; z-index: 3; }
  .desk-status[hidden] { display: none; }
  .desk-btn {
    height: 28px; padding: 0 12px; border-radius: 8px; border: 1px solid rgb(255 255 255 / 0.28); background: rgb(255 255 255 / 0.1);
    color: #f4f2ec; font: 600 13px/1 var(--font); cursor: pointer;
  }
  .desk-btn:hover { background: rgb(255 255 255 / 0.2); }
  .desk-btn:focus-visible { outline: 2px solid #f4f2ec; outline-offset: 2px; }
  @media (max-width: 480px) {
    .desk { height: 300px; }
    .mb-apps span:nth-child(n+3) { display: none; }
    .mb-extras { gap: 9px; }
  }
  @media (max-width: 370px) { .mb-apps span { display: none; } }
</style>

<script>
  // Minutes on the drag ruler up to the default 4-hour maximum, and the lengths it catches at.
  const RUNGS: number[] = [];
  for (let m = 1; m <= 15; m++) RUNGS.push(m);
  for (let m = 20; m <= 60; m += 5) RUNGS.push(m);
  for (let m = 75; m <= 240; m += 15) RUNGS.push(m);
  const SNAPS = new Set([1, 5, 15, 30, 60, 90, 120, 180, 240]);

  const length = (min: number) => {
    const h = Math.floor(min / 60), m = min % 60;
    return h === 0 ? `${m}m` : m === 0 ? `${h}h` : `${h}h ${m}m`;
  };
  const clockTime = (d: Date) => d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
  // What the menu bar shows: 24:59 under an hour, 1h 14m above it.
  const countdown = (ms: number) => {
    const s = Math.max(0, Math.ceil(ms / 1000));
    if (s >= 3600) return `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m`;
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  };
  const countUp = (ms: number) => {
    const s = Math.max(0, Math.floor(ms / 1000));
    return `+${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  };

  document.querySelectorAll<HTMLElement>('[data-drag-demo]').forEach((demo) => {
    const desk = demo.querySelector<HTMLElement>('.desk')!;
    const clock = demo.querySelector<HTMLButtonElement>('[data-clock]')!;
    const count = demo.querySelector<HTMLElement>('[data-count]')!;
    const line = demo.querySelector<SVGLineElement>('[data-line]')!;
    const knob = demo.querySelector<SVGCircleElement>('[data-knob]')!;
    const knobDot = demo.querySelector<SVGCircleElement>('[data-knob-dot]')!;
    const tag = demo.querySelector<HTMLElement>('[data-tag]')!;
    const tagLength = demo.querySelector<HTMLElement>('[data-tag-length]')!;
    const tagTime = demo.querySelector<HTMLElement>('[data-tag-time]')!;
    const hint = demo.querySelector<HTMLElement>('[data-hint]')!;
    const status = demo.querySelector<HTMLElement>('[data-status]')!;
    const statusText = demo.querySelector<HTMLElement>('[data-status-text]')!;
    const reset = demo.querySelector<HTMLButtonElement>('[data-reset]')!;
    const live = demo.querySelector<HTMLElement>('[data-live]')!;
    const now = demo.querySelector<HTMLElement>('[data-now]')!;
    const HINT = hint.textContent ?? '';

    let ends: number[] = [];          // when each running timer ends, soonest first
    let finishedAt: number | null = null;
    let pointerId: number | null = null;
    let start = { x: 0, y: 0 };
    let dragging = false;
    let minutes: number | null = null; // what letting go now would start; null on the clock (Cancel)
    let keyRung = -1;                  // arrow-key mode: index into RUNGS, -1 when not in use
    let lastMessage = '';

    desk.classList.add('idle');

    const origin = () => {
      const d = desk.getBoundingClientRect(), c = clock.getBoundingClientRect();
      return { x: c.left + c.width / 2 - d.left, y: c.top + c.height / 2 - d.top, w: d.width, h: d.height, clockW: c.width, clockH: c.height };
    };
    // One step of the ruler, sized so the far corner of the picture is the 4-hour end.
    const stepSize = (o: ReturnType<typeof origin>) => {
      const reach = Math.hypot(Math.max(o.x, o.w - o.x), o.h - o.y) - 34;
      return Math.min(20, Math.max(5, reach / (RUNGS.length - 1)));
    };

    const say = (text: string) => { if (text !== lastMessage) { lastMessage = text; live.textContent = text; } };

    function preview(x: number, y: number, o: ReturnType<typeof origin>, touch: boolean) {
      const px = Math.min(Math.max(x, 10), o.w - 10), py = Math.min(Math.max(y, 10), o.h - 10);
      const onClock = Math.abs(x - o.x) <= o.clockW / 2 + 2 && Math.abs(y - o.y) <= o.clockH / 2 + 3;
      if (onClock) {
        minutes = null;
      } else {
        const rung = Math.round(Math.hypot(px - o.x, py - o.y) / stepSize(o));
        minutes = RUNGS[Math.min(Math.max(rung, 0), RUNGS.length - 1)];
      }
      desk.classList.add('dragging');
      desk.classList.remove('idle');
      desk.classList.toggle('cancelling', minutes === null);
      desk.classList.toggle('snapped', minutes !== null && SNAPS.has(minutes));
      line.setAttribute('x1', String(o.x)); line.setAttribute('y1', String(o.y));
      line.setAttribute('x2', String(px)); line.setAttribute('y2', String(py));
      for (const c of [knob, knobDot]) { c.setAttribute('cx', String(px)); c.setAttribute('cy', String(py)); }
      tagLength.textContent = minutes === null ? 'Cancel' : length(minutes);
      tagTime.textContent = minutes === null ? '' : `at ${clockTime(new Date(Date.now() + minutes * 60000))}`;
      tag.hidden = false;
      // Under the knob, as in the app; above a finger, and never outside the picture.
      const tw = tag.offsetWidth, th = tag.offsetHeight;
      let ty = minutes === null ? o.y + o.clockH / 2 + 8 : py + 20;
      if (minutes !== null && (touch || ty + th > o.h - 6)) ty = py - th - (touch ? 34 : 20);
      const tx = Math.min(Math.max((minutes === null ? o.x : px) - tw / 2, 6), o.w - tw - 6);
      tag.style.transform = `translate(${Math.round(tx)}px, ${Math.round(Math.max(ty, 38))}px)`;
    }

    function endDrag() {
      dragging = false;
      keyRung = -1;
      minutes = null;
      tag.hidden = true;
      desk.classList.remove('dragging', 'cancelling', 'snapped');
      render();
    }

    function commit() {
      const m = minutes;
      endDrag();
      if (m === null) { say('Cancelled. No timer started.'); return; }
      const end = Date.now() + m * 60000;
      ends.push(end);
      ends.sort((a, b) => a - b);
      say(`${length(m)} timer started. It rings at ${clockTime(new Date(end))}.`);
      render();
    }

    function render() {
      const t = Date.now();
      while (ends.length && ends[0] <= t) { finishedAt ??= ends[0]; ends.shift(); }
      now.textContent = clockTime(new Date(t));
      const finished = finishedAt !== null, running = ends.length > 0;
      desk.classList.toggle('finished', finished);
      desk.classList.toggle('running', running && !finished);
      desk.classList.toggle('idle', !finished && !running && !desk.classList.contains('dragging'));
      count.textContent = finished ? countUp(t - finishedAt!) : running ? countdown(ends[0] - t) : '';
      const any = finished || running;
      status.hidden = !any;
      hint.hidden = any;
      if (finished) {
        statusText.textContent = 'Timer finished';
        reset.textContent = 'Mark done';
      } else if (running) {
        reset.textContent = 'Stop all';
        statusText.textContent = ends.length > 1 ? `${ends.length} timers running · the clock shows the nearest` : `Timer started · rings at ${clockTime(new Date(ends[0]))}`;
      }
    }

    clock.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      pointerId = e.pointerId;
      start = { x: e.clientX, y: e.clientY };
      dragging = false;
      keyRung = -1;
      try { clock.setPointerCapture(e.pointerId); } catch { /* not capturable */ }
      e.preventDefault();
      clock.classList.add('by-pointer');
      clock.focus({ preventScroll: true });
    });
    clock.addEventListener('pointermove', (e) => {
      if (e.pointerId !== pointerId) return;
      if (!dragging && Math.hypot(e.clientX - start.x, e.clientY - start.y) < 4) return;
      dragging = true;
      const d = desk.getBoundingClientRect();
      preview(e.clientX - d.left, e.clientY - d.top, origin(), e.pointerType === 'touch');
    });
    const release = (e: PointerEvent, cancelled: boolean) => {
      if (e.pointerId !== pointerId) return;
      pointerId = null;
      if (!dragging) {
        if (!cancelled && !ends.length && finishedAt === null) hint.textContent = 'In the app a click opens your timers. Here, press and drag.';
        return;
      }
      if (cancelled) { endDrag(); say('Cancelled. No timer started.'); } else commit();
    };
    clock.addEventListener('pointerup', (e) => release(e, false));
    clock.addEventListener('pointercancel', (e) => release(e, true));

    // Escape lets go of a drag, as in the app. The arrow keys are this demo's own, so it can be tried without a pointer.
    clock.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && (dragging || keyRung >= 0)) {
        e.preventDefault();
        pointerId = null;
        endDrag();
        say('Cancelled. No timer started.');
        return;
      }
      if (pointerId !== null) return;
      clock.classList.remove('by-pointer');
      const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (step) {
        e.preventDefault();
        keyRung = Math.min(Math.max(keyRung + step, -1), RUNGS.length - 1);
        if (keyRung < 0) { endDrag(); say('Cancel'); return; }
        const o = origin();
        // Lay the cord out towards the lower left, where there is the most room.
        const far = { x: o.x > o.w / 2 ? 10 : o.w - 10, y: o.h - 10 };
        const total = Math.hypot(far.x - o.x, far.y - o.y), dist = Math.max(keyRung * stepSize(o), 20);
        preview(o.x + ((far.x - o.x) / total) * dist, o.y + ((far.y - o.y) / total) * dist, o, false);
        minutes = RUNGS[keyRung];
        tagLength.textContent = length(minutes);
        tagTime.textContent = `at ${clockTime(new Date(Date.now() + minutes * 60000))}`;
        desk.classList.toggle('snapped', SNAPS.has(minutes));
        desk.classList.remove('cancelling');
        say(`${length(minutes)}, ${tagTime.textContent}`);
      } else if ((e.key === 'Enter' || e.key === ' ') && keyRung >= 0) {
        e.preventDefault();
        commit();
      }
    });
    clock.addEventListener('blur', () => { clock.classList.remove('by-pointer'); if (keyRung >= 0) endDrag(); });

    reset.addEventListener('click', () => {
      if (finishedAt !== null) finishedAt = null; else ends = [];
      hint.textContent = HINT;
      render();
      if (!ends.length && finishedAt === null) clock.focus({ preventScroll: true });
    });

    render();
    window.setInterval(() => { if (!document.hidden) render(); }, 250);
  });
</script>
